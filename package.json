{
  "name": "astra-eclipse-chronicles",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:server": "npm run dev -w @astra/server",
    "dev:client": "npm run dev -w @astra/client",
    "build": "npm run build -w @astra/server && npm run build -w @astra/client",
    "build:offline": "npm run build:offline -w @astra/client",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/client",
    "test": "vitest run",
    "migrate": "npm run migrate -w @astra/server"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.6",
    "esbuild": "^0.25.11",
    "@types/node": "^22.18.0"
  }
}
