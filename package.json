{
  "name": "game-online",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @game/server\" \"npm run dev -w @game/client\"",
    "build": "npm run build -w @game/client",
    "start": "npm run start -w @game/server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:artifact": "node tools/build-artifact.mjs"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
